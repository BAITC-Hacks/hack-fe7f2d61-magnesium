{
  "name": "skillarena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write app components lib tests docs README.md next.config.ts tsconfig.json package.json",
    "dev:frontend": "next dev --hostname 127.0.0.1",
    "dev:backend": "npm run dev --prefix backend",
    "setup": "pnpm install --frozen-lockfile && npm ci --prefix backend",
    "test:integration": "node --import ./backend/node_modules/tsx/dist/loader.mjs --test tests/integration/*.test.ts",
    "check": "pnpm test && pnpm typecheck && npm run check --prefix backend && npm test --prefix backend && pnpm test:integration",
    "build:all": "npm run build --prefix backend && pnpm build"
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  }
}
