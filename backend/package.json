{
  "name": "skillarena-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs watch --clear-screen=false src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "node scripts/demo.mjs",
    "export:openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^5.2.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
