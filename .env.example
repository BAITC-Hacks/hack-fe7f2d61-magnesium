# pnpm dev starts both services and configures the same-origin API proxy.
# For separate frontend startup or production build:
BACKEND_URL=http://127.0.0.1:3001
# Optional direct browser API URL. Leave empty to use the /api proxy.
NEXT_PUBLIC_API_URL=
# Optional custom AI endpoint. Empty uses /api/brief/analyze on the same API.
NEXT_PUBLIC_BRIEF_API_URL=
# AI secrets belong ONLY in backend/.env.
